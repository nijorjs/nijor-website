<body>
    <div class="main" id="sidenav-mobile">
        <div class="heading">
            <a n:route="/" class="logo">
                <img src="/images/logo.svg" />
                <h1>নিজৰ</h1>
            </a>

            <span class="close" on:click="close()">
                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px"
                    fill="black">
                    <path
                        d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
                </svg>
            </span>

        </div>

        <div class="content">
            <ul n:loop source="links" var="link" class:show="{$.route.startsWith('/docs')}">
                <a n:route="{link.url}">
                    <li>{link.title}</li>
                </a>
            </ul>
            <ul class:show="{!$.route.startsWith('/docs')}">
                <a n:route="/docs">
                    <li>Docs</li>
                </a>
                <a n:route="/blogs">
                    <li>Blogs</li>
                </a>
            </ul>
        </div>
    </div>
</body>
<style>
    .main {
        width: 0%;
        height: 100vh;
        z-index: 2;
        background-color: rgb(245, 245, 245);
        box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
        overflow: hidden;
        overflow-y: scroll;
        flex-direction: column;
        position: fixed;
        transition: 0.5s;
    }

    .heading {
        width: 100%;
        height: 5rem;
        display: flex;
        flex-direction: row;
        position: sticky;
    }

    .content {
        height: calc(100vh - 5rem);
        overflow-y: auto;
    }

    .logo {
        padding: 1rem;
        display: flex;
        flex-direction: row;
    }

    .logo h1 {
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 1px;
        position: relative;
        display: inline-block;
        background: linear-gradient(60deg, #00A2E8, #0e73f8, #00A2E8);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: flow 2s linear infinite;
    }

    @keyframes flow {
        0% {
            background-position: 0% center;
        }

        100% {
            background-position: 200% center;
        }
    }

    img {
        margin: 0rem 1rem;
        height: 4rem;
        width: 4rem;
        vertical-align: middle;
    }

    ul {
        list-style: none;
        padding: 0.5rem;
        display: none;

        li {
            color: inherit;
            padding: 0rem 1rem;
            letter-spacing: 1px;


        }

        a {
            margin: 0.5rem;
            padding: 0.5rem;
        }
    }

    .close {
        padding: 2rem;
        margin-left: auto;
    }

    .show {
        display: initial;
    }
</style>
<style theme="dark">
    .main {
        background-color: rgb(27, 27, 29);
        box-shadow: rgba(255, 255, 255, 0.24) 0px 3px 8px;
    }

    svg {
        fill: #e3e3e3;
    }
</style>
<script>
    import { route } from '@/data/state.js';
    import { links } from '@/data/docs.js';

    $.route = route.value;
    route.subscribe(r => $.route = r);

    function close() {
        const sidenav = document.getElementById('sidenav-mobile');
        sidenav.style.width = "0%";
    }
</script>