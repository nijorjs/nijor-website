<body>
    <div class="main">
        <div class="img" style="margin-top: 8rem;"><img src="{Logo}"/></div>
        <div class="txt">
            <p class="tagline typing" on:animationiteration="changeText(this)">Write Less, Do More !</p>
        </div>
        <div class="btns">
            <a n:route="/docs" class="link">Get Started</a>
        </div>
    </div>
</body>

<style>
    .main {
        height: 50rem;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        background-color: rgb(244, 242, 242);
    }

    .btns{
        display: flex;
        flex-direction: row;
    }

    .link {
        margin: 2rem;
        background-color: transparent;
        padding: 1rem 2rem;
        font-weight: 600;
        font-size: 30px;
        letter-spacing: 1px;
        background: -webkit-linear-gradient(60deg, #00A2E8, #0e73f8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .link:hover {
        background: -webkit-linear-gradient(60deg, #00ccff, #00A2E8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transform: scale(1.1);
    }

    .txt {
        margin-top: 5rem;
        display: flex;
        flex-direction: row;
        gap: 10px;
    }

    .tagline {
        font-size: 40px;
        font-weight: bold;
        letter-spacing: 1px;
        background: -webkit-linear-gradient(60deg, #00A2E8, #0e73f8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation-iteration-count: infinite;
    }

    .typing {
        display: inline-block;
        overflow: hidden;
        white-space: nowrap;
        animation: type-delete 6s steps(21, end) infinite, change-color 6s infinite;
    }

    @keyframes type-delete {
        0% {
            width: 0;
        }

        33.33% {
            width: 100%;
        }

        66.67% {
            width: 100%;
        }

        100% {
            width: 0;
        }
    }

    @keyframes change-color {
        0% {
            background: -webkit-linear-gradient(60deg, #006eff, #00A2E8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        12.5%{
            background: -webkit-linear-gradient(60deg, #00A2E8, #5ecfff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        25% {
            background: -webkit-linear-gradient(30deg, #5ecfff, #0ef8f8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        37.5%{
            background: -webkit-linear-gradient(45deg,#0ef8f8, rgb(32, 248, 255));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        50%{
            background: -webkit-linear-gradient(30deg,rgb(32, 248, 255), #ffcbef);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        62.5% {
            background: -webkit-linear-gradient(15.5deg, #0ef8f8, rgb(255, 162, 252));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        75% {
            background: -webkit-linear-gradient(75deg, rgb(255, 162, 252), rgb(255, 119, 119));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        87.5%{
            background: -webkit-linear-gradient(80deg, rgb(255, 119, 119), #ffb3fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        100% {
            background: -webkit-linear-gradient(60deg,#ffb3fe, #00A2E8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    }

    @media only screen and (max-width: 600px) {
        .txt{
            display: none;
        }
    }

</style>
<style theme="dark">
    .main {
        background-color: rgb(28, 28, 28);
    }
</style>
<script>
    import Logo from 'images/logo.svg';

    const texts = [
        "Unleash your Web Wizardy !",
        "Write Less, Do More !"
    ];
    let currentIndex = 0;

    function changeText(element) {
        currentIndex = (currentIndex + 1) % texts.length;
        element.textContent = texts[currentIndex];
        element.style.animation = `type-delete 6s steps(${texts[currentIndex].length}, end) infinite, change-color 6s infinite`;
    }
</script>