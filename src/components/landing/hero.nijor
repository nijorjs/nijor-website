<body>
    <div class="main">
        <div class="img" style="margin-top: 5rem;"><img src="{Logo}" /></div>
        <div class="txt">
            <h1>Nijor</h1>
            <p class="tagline typing" on:animationiteration="changeText(this)">A modern and practical web framework !</p>
        </div>
        <a n:route="/docs" class="link">Get Started ></a>
    </div>
</body>

<style>
    .main {
        height: 50rem;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        background-color: rgb(244, 242, 242);
    }

    .link {
        margin: 2rem;
        background-color: transparent;
        padding: 1rem 2rem;
        font-weight: 600;
        font-size: 30px;
        letter-spacing: 1px;
        background: -webkit-linear-gradient(60deg, #00A2E8, #0e73f8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .link:hover {
        background: -webkit-linear-gradient(60deg, #00ccff, #00A2E8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transform: scale(1.1);
    }

    .txt {
        display: flex;
        flex-direction: row;
        gap: 10px;
    }

    h1 {
        font-size: 40px;
        font-weight: 800;
        background: -webkit-linear-gradient(60deg, #00A2E8, #0e73f8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .tagline {
        font-size: 40px;
        font-weight: bold;
        letter-spacing: 1px;
        background: -webkit-linear-gradient(60deg, #00A2E8, #0e73f8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation-iteration-count: infinite;
    }

    .typing {
        display: inline-block;
        overflow: hidden;
        white-space: nowrap;
        animation: type-delete 6s steps(38, end) infinite;
    }

    @keyframes type-delete {
        0% {
            width: 0;
        }

        33.33% {
            width: 100%;
        }

        66.67% {
            width: 100%;
        }

        100% {
            width: 0;
        }
    }
</style>
<style theme="dark">
    .main {
        background-color: rgb(28, 28, 28);
    }
</style>
<script>
    import Logo from 'images/logo.svg';

    const texts = [
        "Write Less, Do More !",
        "Unleash your Web Wizardy !",
        "A modern and practical web framework !"
    ];
    let currentIndex = 0;

    function changeText(element) {
        currentIndex = (currentIndex + 1) % texts.length;
        element.textContent = texts[currentIndex];
        element.style.animation = `type-delete 6s steps(${texts[currentIndex].length}, end) infinite`;
    }
</script>