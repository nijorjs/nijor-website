<body>
    <div class="footer">
        <div class="footer-main">
            <div class="brand">
                <div class="branding">
                    <img class="brand-logo" src="/images/logo.svg" alt="Nijor logo" />
                    <h2>নিজৰ</h2>
                </div>
                <p>A clean framework for modern web apps.</p>
            </div>

            <nav class="links">
                <a n:route="/docs">Docs</a>
                <a n:route="/blogs">Blog</a>
                <a href="https://github.com/nijorjs" target="_blank" rel="noopener noreferrer">GitHub</a>
            </nav>
        </div>

        <div class="footer-bottom">
            <p>© 2026 Nijor. All rights reserved.</p>
        </div>
    </div>
</body>

<style>
    .footer{
        margin-top: auto;
        padding: 56px 30px 24px 30px;
        background-color: #f5f7fb;
        border-top: 1px solid #e5e7eb;
    }

    .footer-main{
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
    }

    .brand{
        max-width: 420px;
    }

    .branding{
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .brand-logo{
        width: 40px;
        height: 40px;
        display: block;
    }

    h2{
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        background: linear-gradient(60deg, #00A2E8, #0e73f8, #00A2E8, #008be8);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .brand p{
        margin: 0;
        font-size: 16px;
        line-height: 1.7;
        color: #4b5563;
    }

    .links{
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    .links a{
        text-decoration: none;
        color: #374151;
        font-size: 16px;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .links a:hover{
        color: #0e73f8;
    }

    .footer-bottom{
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .footer-bottom p{
        margin: 0;
        font-size: 14px;
        color: #6b7280;
        text-align: center;
    }

    @media only screen and (max-width: 900px){
        .footer{
            padding: 48px 24px 24px 24px;
        }

        .footer-main{
            flex-direction: column;
            align-items: flex-start;
        }

        .links{
            gap: 18px;
        }
    }
</style>

<style theme="dark">
    .footer{
        background-color: rgb(24, 24, 26);
        border-top: 1px solid rgb(42, 42, 46);
    }

    .brand p{
        color: #cdd3db;
    }

    .links a{
        color: #d4d7dd;
    }

    .links a:hover{
        color: #69c7ff;
    }

    .footer-bottom{
        border-top: 1px solid rgb(42, 42, 46);
    }

    .footer-bottom p{
        color: #9ca3af;
    }
</style>
