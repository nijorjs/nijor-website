<body>
    <div class="container">
        <div class="mobile">
            <span class="menu" on:click="open()">
                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="black">
                    <path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z" />
                </svg>
            </span>

            <a n:route="/" class="logo">
                <img src="/images/logo.svg" />
                <h1>নিজৰ</h1>
            </a>
        </div>
        
        <a n:route="/" class="logo desktop-only">
            <img src="/images/logo.svg" />
            <h1>নিজৰ</h1>
        </a>

        <div class="nav-bar">
            <a n:route="/docs" class="nav-link" class:active="{$.route == 'docs'}">Docs</a>
            <a href="https://github.com/nijorjs" class="nav-link">Github</a>
            <a n:route="/blogs" class="nav-link" class:active="{$.route == 'blogs'}">Blog</a>
            <button class="theme-dark-btn" on:click="ChangeTheme()"><svg xmlns="http://www.w3.org/2000/svg"height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z" /></svg></button>
            <button class="theme-light-btn" on:click="ChangeTheme()"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e3e3e3"><path d="M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z" /></svg></button>
        </div>
    </div>
</body>
<style>
    .container {
        width: 100vw;
        height: 6rem;
        background-color: rgba(255, 255, 255);
        box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        position: fixed;
        z-index: 1;
    }

    .logo {
        padding: 1rem;
        display: flex;
        flex-direction: row;
    }

    .logo h1 {
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 1px;
        position: relative;
        display: inline-block;
        background: linear-gradient(60deg, #00A2E8, #0e73f8, #00A2E8);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: flow 2s linear infinite;
    }

    @keyframes flow {
        0% {
            background-position: 0% center;
        }

        100% {
            background-position: 200% center;
        }
    }

    img {
        margin: 0rem 1rem;
        height: 4rem;
        width: 4rem;
        vertical-align: middle;
    }

    .nav-bar {
        height: 100%;
        padding: 0.5rem;
        margin-right: 1rem;
        display: flex;
        flex-direction: row;
        flex-shrink: 0;
    }

    .nav-bar a {
        padding: 0.5rem;
        margin: auto;
        margin-right: 1rem;
    }

    .nav-bar a:hover {
        color: #0099ff;
    }

    .nav-bar button {
        border: none;
        background-color: transparent;
    }

    .active {
        color: rgb(7, 176, 255);
    }

    .theme-dark-btn {
        display: block;
    }

    .theme-light-btn {
        display: none;
    }

    .mobile{
        display: none;
        flex-direction: row;

    }

    .menu {
        vertical-align: middle;
        display: inline-block;
        margin: auto 1rem;
    }

    @media only screen and (max-width: 600px) {
        .mobile {
            display: flex;
        }

        .desktop-only{
            display: none;
        }

        .nav-link {
            display: none;
        }
    }

</style>
<style theme="dark">
    .container {
        background-color: rgb(36, 37, 38);
    }

    .menu svg {
        fill: #e3e3e3;
    }

    .theme-dark-btn {
        display: none;
    }

    .theme-light-btn {
        display: block;
    }
</style>
<script>
    import { route } from '@/data/state.js';
    import { setTheme } from 'nijor/theme';

    function ChangeTheme() {
        document.body.style.transition = "0.3s";
        let Theme = window.localStorage.getItem('theme');

        if (Theme === "auto" || Theme === null) {
            let isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;

            if (isDarkMode) {
                setTheme('light');
                return;
            }

            setTheme('dark');
            return;
        }
        if (Theme === "dark") setTheme("light");
        if (Theme === "light") setTheme("dark");
    }

    function getRoute(url) {
        const Route2TabMap = {
            "/docs": "docs",
            "/examples": "examples",
            "/blogs": "blogs",
        };
        return Route2TabMap['/' + url.split('/')[1]];
    }

    $.route = getRoute(route.value);

    route.subscribe(r => $.route = getRoute(r));

    function open() {
        const sidenav = document.getElementById('sidenav-mobile');
        sidenav.style.width = "75%";
    }
</script>