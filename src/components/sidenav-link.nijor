<body props="{title, _text_}">
    <div class="links-div" data-active="false">
        <div class="heading" on:click="OpenClose(this)">
            <span style="font-size: 24px;">{title}</span>
            <span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="black"><path d="M480-360 280-560h400L480-360Z"/></svg></span>
        </div>
        <div class="sub-links">
            {_text_}
        </div>
    </div>
</body>
<style>
    .heading{
        margin-left: 1rem;
        padding: 0.5rem;
    }

    span{
        display: inline-block;
        vertical-align: middle;
    }

    svg{
        fill : black;
    }

    .links-div[data-active='false'] .sub-links{ display: none; }
    .links-div[data-active='true'] .arrow{ transform: rotate(180deg); }

</style>
<style theme="dark">
    svg{
        fill : white;
    }
</style>
<script>
    function OpenClose(_this){
        const parent = _this.parentElement;
        const active = parent.getAttribute('data-active') === 'false' ? 'true' : 'false';
        parent.setAttribute('data-active',active);
    }
</script>