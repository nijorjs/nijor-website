<body>
    <ul on:route="ChangeRoute(this, $data)" nfor="link in Links">
        <!-- <li><a class="nav-link-docs" n:route="{link.url}">{link.title}</a></li> -->
        <li><a class="nav-link-docs" n:route="/docs">Introduction</a></li>
        <li><a class="nav-link-docs" n:route="/docs/setup">Setup</a></li>
        <li><a class="nav-link-docs" n:route="/docs/cli">CLI</a></li>
        <li><a class="nav-link-docs" n:route="/docs/components">Components</a></li>
        <li><a class="nav-link-docs" n:route="/docs/routing">Routing</a></li>
        <li><a class="nav-link-docs" n:route="/docs/custom-events">Custom Events</a></li>
        <li><a class="nav-link-docs" n:route="/docs/loops">Loops</a></li>
        <li><a class="nav-link-docs" n:route="/docs/fetch">Fetching data</a></li>
        <li><a class="nav-link-docs" n:route="/docs/reactivity">Reactivity</a></li>
        <li><a class="nav-link-docs" n:route="/docs/switch">Switch Show</a></li>
        <li><a class="nav-link-docs" n:route="/docs/themes">Themes</a></li>
        <li><a class="nav-link-docs" n:route="/docs/style-modules">Style Modules</a></li>
    </ul>
</body>
<style>
    ul{
        list-style: none;
        padding: 0.5rem;
    }
    li{ margin: 0.5rem 0.5rem; }
    li a{
        padding: 0.5rem;
        color: black;
    }
    li a[data-active="true"]{
        color:#07b0ff;
    }
 
</style>
<style theme="dark">
    li a{
        color: white;
    }
    li a[data-active="true"]{
        color:#07b0ff;
    }
</style>
<script>
    function ChangeRoute(_this,route){
        _this.querySelectorAll('.nav-link-docs').forEach(element=>{
            element.setAttribute('data-active','false');
            if(element.getAttribute('href')===route){
                element.setAttribute('data-active','true');
            }
        });
    }

    const Links = [
        {title: 'Introduction', url : '/docs'},
        {title: 'Setup', url : '/docs/setup'},
        {title: 'CLI', url : '/docs/cli'},
        {title: 'Components', url : '/docs/components'},
        {title: 'Routing', url : '/docs/routing'},
        {title: 'Custom Events', url : '/docs/custom-events'},
        {title: 'Loops', url : '/docs/loops'},
        {title: 'Data Fetching', url : '/docs/fetch'},
        {title: 'Reactivity', url : '/docs/reactivity'},
        {title: 'Switch-Show', url : '/docs/switch'},
        {title: 'Themes', url: '/docs/themes'},
        {title: 'Style Modules', url : '/docs/style-modules'}
    ];
</script>