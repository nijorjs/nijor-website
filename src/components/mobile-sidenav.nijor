<doc_links n:imported="components/docs/links-index"/>
<art_links n:imported="components/articles/links-index"/>
<sidelink n:imported="components/sidenav-link"/>

<body>
    <div class="main" id="docs-sidenav-mobile">
        <div class="top-bar">
            <a n:route="/">
                <div class="logo">
                    <img src="{Logo}">
                    <h1>Nijor</h1>
                </div>
            </a>
            <span class="close" on:click="CloseMenu()">
                <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="black"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
            </span>
        </div>
        <sidelink title="Docs"><doc_links></doc_links></sidelink>
        <sidelink title="Articles"><art_links></art_links></sidelink>
        <a href="https://github.com/nijorjs/nijor"><span style="font-size: 24px; vertical-align: middle; margin-left: 1rem; padding: 0.5rem;">Github</span></a>
    </div>
</body>

<style>
    .main {
        width: 75%;
        height: 100vh;
        background-color: rgb(245, 245, 245);
        overflow: hidden;
        overflow-y: scroll;
        display: none;
        flex-direction: column;
        position: fixed;
        z-index: 2;
        transition: 0.5s;
    }

    .top-bar {
        padding: 0.5rem;
        display: flex;
        flex-direction: row;
    }

    .logo{
        display: flex;
        flex-direction: row;
        padding: 0.5rem;
    }

    .logo h1 {
        font-weight: 600;
        letter-spacing: 1px;
        vertical-align: middle;
        background: -webkit-linear-gradient(60deg, #00A2E8, #0e73f8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    img {
        margin: 0rem 1rem;
        height: 4rem;
        width: 4rem;
        vertical-align: middle;
    }

    .close{
        margin-left: auto;
        display: grid;
        place-self: center;
        padding-right: 0.5rem;
    }

    .close:hover svg{
        fill : #0099ff;
    }

    @media only screen and (max-width: 600px) {
        .main {
            display: flex;
            width: 0%;
        }
    }

</style>

<style theme="dark">
    .main {
        background-color: rgb(29, 41, 48);
    }

    svg {
        fill: #e3e3e3;
    }
</style>

<script>
    import Logo from 'images/logo.svg';

    function CloseMenu() {
        const sidenav = document.getElementById('docs-sidenav-mobile');
        sidenav.style.width = "0%";
    }

</script>