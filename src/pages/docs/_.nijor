<sidenav n:imported="components/docs/sidenav" />

<body>
    <div class="container">
        <sidenav></sidenav>
        <div class="docs-div" n:slot on:click="CloseNav()"></div>
    </div>
</body>

<style>
    .container {
        width: 100%;
        height: calc(100vh - 5rem);
        display: flex;
        flex-direction: row;
    }

    .docs-div {
        width: 80%;
        height: calc(100vh - 5rem);
        overflow-x: hidden;
        overflow-y: auto;
    }

    @media only screen and (min-width: 600px) {
        
        .docs-div::-webkit-scrollbar {
            background-color: rgb(218, 214, 214);
            width: 8px;
        }

        .docs-div::-webkit-scrollbar-thumb {
            background-color: rgb(233, 232, 232);
            width: 8px;
            height: 8px;
        }

        .docs-div::-webkit-scrollbar-thumb:hover,.docs-div::-webkit-scrollbar-thumb:active {
            background-color: #0099ff;
        }
    }

    @media only screen and (max-width: 600px) {
        .docs-div {
            width: 100%;
        }
    }
</style>

<script>
    function CloseNav(){
        const sidenav = document.getElementById('docs-sidenav-mobile');
        if(sidenav.style.width=="75%") sidenav.style.width = "0%";
    }
</script>